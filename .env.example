# CareQueue environment variables
#
# Copy to .env.local and fill in. .env.local is gitignored — never commit
# real values, and rotate anything that has ever been committed or pasted
# into a chat, ticket, or log.

# ─── Database ────────────────────────────────────────────────────────────
# Use a database user scoped to this application's database only, not an
# Atlas admin account.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/carequeue

# ─── Sessions ────────────────────────────────────────────────────────────
# Signs the session JWT. Must be at least 32 characters — lib/auth/jwt.ts
# refuses to start otherwise. Generate one with:
#   openssl rand -base64 48
# Changing this invalidates every existing session, which is the intended
# way to force a global sign-out.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ─── Canonical app URL ───────────────────────────────────────────────────
# Used to verify Twilio webhook signatures and to allow-list the origin of
# state-changing requests. Set this in every deployed environment; without
# it both checks fall back to the request's Host header.
# No trailing slash.
NEXT_PUBLIC_APP_URL=https://carequeue.example.com

# ─── Twilio (WhatsApp) ───────────────────────────────────────────────────
# TWILIO_AUTH_TOKEN doubles as the webhook signing key. If it is unset in
# production the webhook refuses every request rather than trusting
# unsigned input.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+2340000000000

# ─── Anthropic (smart scheduling) ────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Cron ────────────────────────────────────────────────────────────────
# Shared secret for the Vercel cron job. Generate with:
#   openssl rand -base64 32
CRON_SECRET=

# ─── Cloudinary (patient documents and avatars) ──────────────────────────
# Patient documents are uploaded with authenticated delivery, so the API
# secret is what gates access to them. Treat it as a PHI credential.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Seeding (development only) ──────────────────────────────────────────
# Optional. If unset, `npm run seed` generates random passwords and prints
# them once. The seed script deletes all data and refuses to run against a
# production database without ALLOW_DESTRUCTIVE_SEED=1.
# SEED_ADMIN_EMAIL=admin@carequeue.local
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_PASSWORD=
# SEED_PATIENT_PASSWORD=
